{
  "name": "@nutui/nutui-react-taro-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "NutUI React Taro 面向 AI Coding 的离线知识查询 CLI：list / info / doc / demo / token。",
  "keywords": [
    "nutui",
    "nutui-react",
    "nutui-react-taro",
    "taro",
    "cli",
    "ai-coding",
    "llm",
    "react component"
  ],
  "license": "MIT",
  "author": "jdcfe",
  "homepage": "https://github.com/jdf2e/nutui-react.git",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdf2e/nutui-react.git"
  },
  "bin": {
    "nutui-react-taro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "skills"
  ],
  "engines": {
    "node": ">=18.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "build": "node scripts/prepare-data.mjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp && pnpm publish",
    "release:beta": "bumpp --preid beta && pnpm publish --tag beta"
  },
  "dependencies": {
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@nutui/nutui-react-cli-core": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/yargs": "^17.0.35",
    "bumpp": "^9.11.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2"
  }
}
